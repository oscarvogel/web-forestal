<section id="servicios" class="py-20 bg-slate-50 dark:bg-gray-800">
    <div class="container mx-auto px-6 section-hidden">
        <div class="w-fit pb-1 px-2 mx-4 mb-12 rounded-md text-2xl font-semibold border-b-2 border-blue-600 dark:border-blue-400 relative 
        before:absolute before:bottom-0 before:left-0 before:w-1/3 before:h-[2px] before:bg-blue-300 before:opacity-70">
            Servicios de Forestal Garuhapé
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {% for servicio in todos_los_servicios %}
            <div class="group relative bg-white dark:bg-gray-900 rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 
            overflow-hidden flex flex-col">
                    <!-- Imagen -->
                    <div class="relative overflow-hidden h-56">
                        <img class="w-full h-full object-cover transform transition-transform duration-500 group-hover:scale-105" 
                             src="{{ servicio.imagen }}" 
                             alt="{{ servicio.titulo }}">
                        <div class="absolute inset-0 bg-gradient-to-r from-blue-500/20 to-purple-500/20 mix-blend-multiply"></div>
                    </div>
                    
                    <!-- Contenido -->
                    <div class="p-6 flex flex-col flex-1">
                        <div class="mb-4 flex items-center gap-3">
                            <div class="w-12 h-12 bg-blue-100 dark:bg-blue-900 rounded-lg flex items-center justify-center">
                                <!-- Icono (puedes reemplazar con un SVG real) -->
                                <svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                                </svg>
                            </div>
                            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">
                                {{ servicio.titulo }}
                            </h2>
                        </div>
                        
                        <p class="text-base text-gray-600 dark:text-gray-300 leading-relaxed mb-6">
                            {{ servicio.descripcion }}
                        </p>
                        
                        <div class="mt-auto">
                            <a href="/servicios/{{ servicio.slug }}/" class="inline-flex items-center text-blue-600 dark:text-blue-400 font-medium hover:text-blue-800 
                            dark:hover:text-blue-300 transition-colors">
                                Ver detalles
                                <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                                </svg>
                            </a>
                        </div>
                    </div>
            </div>
        {% endfor %}
        </div>
    </div>
</section>