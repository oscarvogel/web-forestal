<section class="py-20 bg-slate-50 dark:bg-slate-900">
    <div class="container mx-auto px-4 lg:px-8">
        <div class="w-fit pb-1 px-2 mx-4 mb-8 rounded-md text-2xl font-semibold border-b-2 border-blue-600 dark:border-blue-400">
            {{ galeria.sectionTitle }}
        </div>

        <!-- Slider Gallery (4 cards view) -->
        <div class="gallery-slider relative">
            <div class="slider-viewport overflow-hidden rounded-lg">
                <div class="slides flex gap-3" data-count="{{ galeria.imagenes | length }}">
                    {% for imagen in galeria.imagenes %}
                    <div class="slide flex-shrink-0 aspect-square rounded-lg overflow-hidden bg-white">
                        <img src="{{ imagen.src }}" alt="{{ imagen.alt }}" loading="lazy"
                             class="w-full h-full object-cover">
                    </div>
                    {% endfor %}
                </div>
            </div>

            <!-- Controls -->
            <button class="slider-prev absolute left-3 top-1/2 -translate-y-1/2 bg-black/40 text-white p-2 rounded-full">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                </svg>
            </button>
            <button class="slider-next absolute right-3 top-1/2 -translate-y-1/2 bg-black/40 text-white p-2 rounded-full">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
            </button>

            <!-- Dots (created by JS as pages) -->
            <div class="slider-dots flex gap-2 justify-center mt-4"></div>
        </div>
    </div>
</section>