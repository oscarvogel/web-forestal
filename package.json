{
    "name": "forestal-garuhape",
    "version": "1.0.0",
    "description": "Sitio web de Forestal Garuhapé SA",
    "scripts": {
        "start": "eleventy --serve",
            "build": "node scripts/build.js",
        "watch": "eleventy --watch",
        "test": "npm run build && node scripts/check-contact.mjs",
        "dev": "npm-run-all --parallel dev:*",
        "dev:eleventy": "eleventy --serve",
        "dev:tailwind": "tailwindcss -i ./src/css/tailwind.css -o ./_site/css/styles.css --watch",
        "build:tailwind": "tailwindcss -i ./src/css/tailwind.css -o ./_site/css/styles.css --minify",
        "clean": "rm -rf _site"
    },
    "keywords": [],
    "author": "Tu Nombre",
    "license": "MIT",
    "dependencies": {
        "@11ty/eleventy": "^2.0.1",
        "tailwindcss": "^3.3.3"
    },
    "devDependencies": {
        "autoprefixer": "^10.4.15",
        "npm-run-all": "^4.1.5",
        "postcss": "^8.4.24",
        "postcss-import": "^15.1.0"
    }
}
