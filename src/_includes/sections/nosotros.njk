<section id="nosotros" class="py-20 bg-slate-50">
    <div class="container mx-auto px-6 section-hidden">
        <div class="w-fit pb-1 px-2 mx-4 rounded-md text-2xl font-semibold border-b-2 border-blue-600">
            {{ nosotros.tituloSeccion }}
        </div>

        <div class="flex flex-col lg:flex-row items-start gap-12 mt-16">
            <!-- Columna de texto -->
            <div class="lg:w-1/2">
                <h2 class="text-4xl font-bold text-gray-900 mb-8">
                    Forestal Garuhapé SA
                </h2>
                
                <!-- Visión destacada -->
                <div class="bg-gradient-to-r from-emerald-600 to-emerald-700 text-white p-6 rounded-lg mb-8 shadow-lg">
                    <h3 class="text-xl font-bold mb-3 flex items-center">
                        <svg class="w-6 h-6 mr-2" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M10 12a2 2 0 100-4 2 2 0 000 4z"/>
                            <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"/>
                        </svg>
                        Nuestra Visión
                    </h3>
                    <p class="text-base leading-relaxed">
                        {{ nosotros.vision }}
                    </p>
                </div>
                
                <p class="text-lg text-gray-700 leading-relaxed mb-8">
                    {{ nosotros.descripcion }}
                </p>

                <a href="/nosotros/" class="inline-flex items-center rounded bg-emerald-600 text-white px-4 py-2 hover:bg-emerald-700 transition-colors mb-8">Leer más sobre nosotros</a>

                <!-- Consultoría y Servicios en dos columnas -->
                <div class="grid md:grid-cols-2 gap-8">
                    <!-- Consultoría -->
                    <div>
                        <h3 class="text-xl font-bold text-emerald-700 mb-4 uppercase tracking-wide">
                            Consultoría
                        </h3>
                        <ul class="space-y-2">
                            {% for item in nosotros.consultoria %}
                            <li class="flex items-start text-gray-700">
                                <svg class="w-5 h-5 mr-2 mt-0.5 flex-shrink-0 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
                                    <path d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"/>
                                </svg>
                                <span class="text-sm">{{ item }}</span>
                            </li>
                            {% endfor %}
                        </ul>
                    </div>

                    <!-- Servicios -->
                    <div>
                        <h3 class="text-xl font-bold text-emerald-700 mb-4 uppercase tracking-wide">
                            Servicios
                        </h3>
                        <ul class="space-y-2">
                            {% for item in nosotros.servicios %}
                            <li class="flex items-start text-gray-700">
                                <svg class="w-5 h-5 mr-2 mt-0.5 flex-shrink-0 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
                                    <path d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"/>
                                </svg>
                                <span class="text-sm">{{ item }}</span>
                            </li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Columna de imagen -->
            <div class="lg:w-1/2 flex items-start">
                <img src="{{ nosotros.imagen }}" 
                     alt="Forestal Garuhapé" 
                     class="w-full h-[420px] lg:h-[680px] object-cover object-center rounded-xl shadow-lg">
            </div>
        </div>
    </div>
</section>
