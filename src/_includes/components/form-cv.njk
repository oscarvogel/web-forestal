<!-- src/components/form-cv.njk -->

<div class="relative min-h-screen flex flex-col items-center justify-center pt-20">

    <h2 class="text-3xl font-bold text-center mb-6">¡Únetenos! 🚀</h2>
    <p class="text-center mb-8 text-gray-600">
        Unite a nosotros como uno de los miembros más destacados de nuestro equipo.
        Envía tu CV y nosotros nos comunicaremos contigo.
    </p>

    <form 
    class="max-w-lg mx-auto space-y-6 bg-white p-8 rounded-lg shadow-md"
    action="YOUR_FORMSPREE_OR_NETLIFY_FORM_URL"
    method="POST"
    enctype="multipart/form-data"
    >
    <h2 class="text-2xl font-bold text-gray-800 mb-6">Subir CV</h2>
    
    <div class="space-y-4">
        <!-- Campos del formulario -->
        <div>
        <label class="block text-gray-700 text-sm font-medium mb-2">
            Nombre completo
        </label>
        <input
            type="text"
            name="name"
            class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            required
        >
        </div>

        <div>
        <label class="block text-gray-700 text-sm font-medium mb-2">
            Correo electrónico
        </label>
        <input
            type="email"
            name="email"
            class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            required
        >
        </div>

        <div class="space-y-4">
        <label class="block text-gray-700 text-sm font-medium mb-2">
            Subir CV (PDF u Word)
        </label>
        <input
            type="file"
            name="cv"
            class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
            accept=".pdf,.doc,.docx"
            required
        >
        <p class="text-sm text-gray-500 mt-1">
            Formatos permitidos: PDF, DOC, DOCX (máximo 5MB)
        </p>
        </div>

        <div class="flex justify-center">
        <button
            type="submit"
            class="w-full md:w-auto px-8 py-3 bg-blue-600 text-white rounded-md hover:bg-blue-700 transition-colors"
        >
            Enviar CV
        </button>
        </div>
    </div>

    <!-- Opcional: Zona de arrastrar y soltar para subir el CV -->
    <div class="mt-6 text-center">
        <p class="text-gray-500 text-sm mb-2">
        O arrastra tu CV aquí
        </p>
        <div class="border-2 border-dashed border-gray-300 rounded-lg p-8 text-gray-500 hover:border-blue-500 cursor-pointer">
        <p class="text-sm">Arrastra tu archivo aquí</p>
        </div>
    </div>
    </form>
</div>