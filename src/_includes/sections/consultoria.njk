<section class="py-20 bg-gradient-to-b from-white to-blue-50 dark:from-slate-900 dark:to-slate-800">
  <div class="container mx-auto px-4 lg:px-8 max-w-7xl">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-bold text-slate-800 dark:text-white mb-4 relative inline-block">
        <span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-600 to-emerald-600">
          Servicios de Consultoría Especializada
        </span>
      </h2>
      <div class="w-24 h-1 bg-gradient-to-r from-blue-400 to-emerald-400 mx-auto mt-4 rounded-full"></div>
    </div>

    <div class="grid md:grid-cols-2 gap-8">
      {% for servicio in consultoria %}
      <article class="group relative bg-white dark:bg-slate-800 p-8 rounded-xl shadow-sm hover:shadow-lg transition-all duration-300 border border-slate-100 dark:border-slate-700 hover:border-blue-100 dark:hover:border-blue-900/50 flex flex-col min-h-[500px]">
        <div class="absolute top-0 right-0 w-16 h-16 overflow-hidden">
          <div class="absolute -right-8 top-0 w-32 h-8 bg-blue-100 dark:bg-blue-900/30 transform -rotate-45 transition-all duration-500 group-hover:opacity-0"></div>
        </div>

        <div class="flex flex-col h-full justify-between">
          <figure class="relative mb-6 overflow-hidden rounded-lg aspect-video bg-slate-100 dark:bg-slate-700">
            <img
              src="{{ servicio.imagen }}"
              alt="{{ servicio.titulo }}"
              loading="lazy"
              decoding="async"
              width="1536"
              height="864"
              class="w-full h-full object-cover transform transition-transform duration-500 group-hover:scale-105"
            >
            <div class="absolute inset-0 bg-gradient-to-t from-slate-900/25 to-transparent"></div>
          </figure>

          <div class="flex flex-col">
            <div class="w-14 h-14 flex items-center justify-center bg-blue-50 dark:bg-blue-900/20 rounded-lg mb-4 transition-colors duration-300 group-hover:bg-blue-100 dark:group-hover:bg-blue-900/30">
              <svg class="w-8 h-8 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/>
              </svg>
            </div>

            <h3 class="text-xl font-semibold text-slate-800 dark:text-white mb-3">
              {{ servicio.titulo }}
            </h3>
            <p class="text-slate-600 dark:text-slate-300 leading-relaxed text-[15.5px]">
              {{ servicio.descripcion }}
            </p>
          </div>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
