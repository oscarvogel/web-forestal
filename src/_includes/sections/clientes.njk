<section class="py-20 bg-slate-50" id="clientes">
    <div class="container mx-auto px-6 section-hidden">
        <div class="w-fit pb-1 px-2 mx-4 rounded-md text-2xl font-semibold border-b-2 border-blue-600">
            {{ clientes.tituloSeccion }}
        </div>
        
        <div class="w-full px-4 pt-16 pb-16">
            <p class="pt-6 pb-8 text-base max-w-2xl text-center mx-auto">
                {{ clientes.descripcion }}
            </p>
            
            <div class="mx-auto w-full max-w-4xl grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-4">
                {% for cliente in clientes.clientes %}
                <a 
                    href="{{ cliente.enlace }}" 
                    target="_blank" 
                    class="group"
                    rel="noopener noreferrer"
                >
                    <img 
                        src="{{ cliente.logo }}" 
                        alt="{{ cliente.alt }}"
                        class="w-32 h-24 mx-auto object-contain filter grayscale opacity-70 hover:opacity-100 transition-all duration-300"
                        loading="lazy"
                    >
                </a>
                {% endfor %}
            </div>
        </div>
    </div>
</section>