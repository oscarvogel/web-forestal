# Plantilla de configuracion de despliegue. Copiala como .env y completala.
# El .env real esta en .gitignore y nunca se sube. No pongas contrasenas reales
# en este archivo: es la version que queda en el repo.
#
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (Linux/Mac)

# Servidor FTP/SFTP del hosting (ej. ftp.tuhosting.com.ar)
DEPLOY_HOST=

# Usuario FTP del hosting
DEPLOY_USER=

# Contrasena del usuario FTP. Entre comillas simples si tiene caracteres especiales
DEPLOY_PASS=

# 21 para FTP, 22 para SFTP
DEPLOY_PORT=21

# ftp o sftp
DEPLOY_PROTOCOL=ftp

# Directorio donde vive el sitio en el servidor (document root)
DEPLOY_DIR=/public_html/

# SI solo cuando haya que autorizar la subida a produccion
DEPLOY_CONFIRM=NO

# Dominio para verificar el sitio despues de subir
DEPLOY_CHECK_URL=https://forestalgaruhape.com.ar

# Cuantos archivos verificar al terminar (0 = todos)
DEPLOY_VERIFY_COUNT=30